{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flash & Debug (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "D:/ST/workspace/compiler/xpack-openocd-0.12.0-5/bin/openocd.exe",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/huaweike.elf",
            
            // 调试器接口与芯片
            "device": "APM32F103CBT6",
            "interface": "swd",
            
            // ==========================================
            // 重要：请修改这里的 OpenOCD 安装路径！
            // ==========================================
            "searchDir": [
                "D:/ST/workspace/compiler/xpack-openocd-0.12.0-5/openocd/scripts/"
            ],
            "configFiles": [
                // "interface/cmsis-dap.cfg", // CMSIS-DAP 专用
                "interface/stlink.cfg",
                "target/stm32f1x.cfg" // APM32F1 兼容 STM32F1 配置
            ],
            
            // 调试前自动编译
            "preLaunchTask": "CMake Build",
            
            // 运行到 main 函数暂停
            "runToEntryPoint": "main",
            
            // 实时变量监控
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 2
            },
            
            // 可选：如果你有 APM32F1 的 SVD 文件，取消下面这行的注释
            // "svdFile": "${workspaceFolder}/APM32F103xx.svd",
            "svdFile": "${workspaceFolder}/APM32F103xB.svd",
            
            "showDevDebugOutput": "none"
        }
    ]
}